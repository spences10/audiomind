{
	"name": "audiomind",
	"version": "0.0.1",
	"private": true,
	"bin": {
		"audiomind": "./src/cli/index.ts"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"cli": "node --experimental-strip-types --env-file=.env ./src/cli/index.ts",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test:client": "vp test --project=client",
		"test:server": "vp test --project=server",
		"test:ci": "vp test --run",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.36",
		"@ai-sdk/svelte": "^4.0.70",
		"@deepgram/sdk": "^5.0.0",
		"ai": "^6.0.70",
		"better-sqlite3": "^12.6.2",
		"citty": "^0.2.0",
		"date-fns": "^4.1.0",
		"mode-watcher": "^1.1.0",
		"music-metadata": "^11.11.2",
		"runed": "^0.37.1",
		"sqlite-vec": "0.1.9",
		"svelte-exmarkdown": "^5.0.2",
		"svelte-sonner": "^1.0.7",
		"svelte-streamdown": "^3.0.1",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^1.0.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.5",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"playwright": "1.64.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=12.0.0"
	},
	"packageManager": "pnpm@12.16.1"
}
